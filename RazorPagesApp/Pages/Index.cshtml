@page
@model RazorPagesApp.Pages.IndexModel

@{
    ViewData["Title"] = "Головна";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Список студентів</h1>
        <a asp-page="Create" class="btn btn-success">+ Додати нового студента</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm rounded">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Students[0].Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Students[0].Surname)</th>
                    <th>@Html.DisplayNameFor(model => model.Students[0].Age)</th>
                    <th>@Html.DisplayNameFor(model => model.Students[0].GPA)</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Students) {
                    <tr>
                        <td class="align-middle">@Html.DisplayFor(modelItem => item.Name)</td>
                        <td class="align-middle">@Html.DisplayFor(modelItem => item.Surname)</td>
                        <td class="align-middle">@Html.DisplayFor(modelItem => item.Age)</td>
                        <td class="align-middle">@Html.DisplayFor(modelItem => item.GPA)</td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редагувати</a>
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>