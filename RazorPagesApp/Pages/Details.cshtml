@page
@model RazorPagesApp.Pages.DetailsModel

@{
    ViewData["Title"] = "Деталі";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="mt-4">
    <h1>Деталі</h1>
    
    <div class="card mt-4 shadow-sm w-50">
        <div class="card-header">
            <h4 class="mb-0">Студент</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Student.Name)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Student.Name)</dd>
                
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Student.Surname)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Student.Surname)</dd>
                
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Student.Age)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Student.Age)</dd>
                
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Student.GPA)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Student.GPA)</dd>
            </dl>
        </div>
        <div class="card-footer bg-transparent">
            <a asp-page="./Edit" asp-route-id="@Model.Student?.Id" class="btn btn-primary">Редагувати</a>
            <a asp-page="./Index" class="btn btn-secondary ms-2">Повернутися до списку</a>
        </div>
    </div>
</div>